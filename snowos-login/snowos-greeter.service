[Unit]
Description=SnowOS Digital Frost Greeter
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty1.service
Conflicts=getty@tty1.service
Wants=systemd-udev-settle.service

[Service]
Type=idle
ExecStart=/bin/bash /home/develop/snowos/snowos-login/snowos-login-bootstrap.sh
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
