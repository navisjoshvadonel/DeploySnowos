[Unit]
Description=SnowOS SnowControl Interface
Documentation=https://github.com/snowos/core
After=snowos-boot.service snowos-broker.service snowos-sentinel.service snowos-aicore.service
Requires=snowos-boot.service snowos-broker.service

[Service]
Type=simple
User=snowos-sys
Group=snowos-sys
EnvironmentFile=-/etc/snowos/snowos.env
WorkingDirectory=/opt/snowos
RuntimeDirectory=snowos
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /opt/snowos/app_layer/snow_control/backend/server.py
Restart=always
RestartSec=3

# Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/snowos

[Install]
WantedBy=multi-user.target
