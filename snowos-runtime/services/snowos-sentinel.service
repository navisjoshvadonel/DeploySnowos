[Unit]
Description=SnowOS AI Sentinel Daemon
Documentation=https://github.com/snowos/core
After=snowos-boot.service snowos-broker.service
Requires=snowos-boot.service snowos-broker.service

[Service]
Type=simple
User=snowos-sys
Group=snowos-sys
EnvironmentFile=-/etc/snowos/snowos.env
WorkingDirectory=/opt/snowos
ExecStart=/usr/bin/python3 /opt/snowos/system_services/ai_sentinel/sentinel_daemon.py
Restart=always
RestartSec=3

# Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/snowos

[Install]
WantedBy=multi-user.target
