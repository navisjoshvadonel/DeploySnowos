[Unit]
Description=SnowOS AI Sentinel Daemon
Documentation=https://github.com/snowos/core
After=snowos-boot.service snowos-broker.service
Requires=snowos-boot.service snowos-broker.service

[Service]
Type=simple
User=snowos-sys
Group=snowos-sys
RuntimeDirectory=snowos
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=yes
EnvironmentFile=-/etc/snowos/snowos.env
WorkingDirectory=/opt/snowos
ExecStart=/usr/bin/python3 /opt/snowos/system_services/ai_sentinel/sentinel_daemon.py
Restart=always
RestartSec=3

# Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/run/snowos /tmp
# Allow journal reads for crash log extraction
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
