[Unit]
Description=SnowOS AI Core — Nyx Cognitive Engine (Headless Daemon)
Documentation=https://github.com/snowos/core
After=network.target snowos-boot.service snowos-broker.service
Requires=snowos-boot.service
Wants=snowos-broker.service

[Service]
Type=simple
User=snowos-ai
Group=snowos
EnvironmentFile=-/etc/snowos/snowos.env
# NYX_API_KEY must be set in snowos.env or the environment
EnvironmentFile=-/etc/snowos/secrets/nyx_api_key.env
WorkingDirectory=/opt/snowos/ai
# NyxDaemon — headless AI core service wrapper
ExecStart=/usr/bin/python3 /opt/snowos/ai/nyx_daemon.py
Restart=on-failure
RestartSec=10
# Allow up to 3 restarts in 120s before giving up
StartLimitIntervalSec=120
StartLimitBurst=3

# Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/snowos /var/log/snowos /run/snowos /tmp

# Systemd watchdog — if Nyx hangs, restart it
WatchdogSec=120

[Install]
WantedBy=multi-user.target
