[Unit]
Description=SnowOS Nyx AI Healing Bridge Daemon
Documentation=https://github.com/snowos/core
After=snowos-boot.service snowos-broker.service snowos-sentinel.service
Wants=snowos-sentinel.service

[Service]
Type=notify
User=snowos-sys
Group=snowos-sys
RuntimeDirectory=snowos
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=yes
EnvironmentFile=-/etc/snowos/snowos.env
WorkingDirectory=/opt/snowos
ExecStart=/usr/bin/python3 /opt/snowos/ai_core/nyxvfs/healing_bridge.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=3
# Systemd watchdog — restarts bridge if it hangs on a stale socket or deadlock
WatchdogSec=60

# Sandboxing & least privilege
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ReadWritePaths=/run/snowos /tmp /snapshots
# Allow journal reading for crash log inspection; drop ptrace
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
