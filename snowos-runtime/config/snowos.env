SNOWOS_BRAND_NAME=SnowOS
SNOWOS_BRAND_CHANNEL=NYX
SNOWOS_RUNTIME_DIR=/run/snowos
SNOWOS_STATE_DIR=/var/lib/snowos
SNOWOS_LOG_DIR=/var/log/snowos
SNOWOS_CONTROL_HOST=127.0.0.1
SNOWOS_CONTROL_PORT=8000
SNOWOS_ALLOW_DEGRADED_SENTINEL=0
SNOWOS_BOOT_MANIFEST_FILE=/etc/snowos/boot_manifest.json
SNOWOS_AI_FEATURES_FILE=/etc/snowos/ai_features.json
SNOWOS_BRAND_FILE=/etc/snowos/brand.json
SNOWOS_INTEGRITY_MANIFEST_FILE=/etc/snowos/integrity_manifest.json
SNOWOS_BOOT_STATUS_FILE=/run/snowos/boot-status.json
SNOWOS_FEATURE_FLAGS_FILE=/run/snowos/feature-flags.json
SNOWOS_BOOT_HISTORY_FILE=/var/log/snowos/boot-history.jsonl
SNOWOS_WORKSPACE_STATE_FILE=/var/lib/snowos/ui_state.json
SNOWOS_BOOT_PROFILE=balanced
SNOWOS_BOOT_STRICT_INTEGRITY=0
SNOWOS_BOOT_TAKE_SNAPSHOT=1
