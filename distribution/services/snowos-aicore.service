[Unit]
Description=SnowOS AI Core — Nyx Cognitive Engine (Headless Daemon)
Documentation=https://github.com/snowos/core
After=network.target snowos-boot.service snowos-broker.service
Requires=snowos-boot.service
Wants=snowos-broker.service

[Service]
Type=simple
User=snowos-ai
Group=snowos
EnvironmentFile=-/etc/snowos/snowos.env
EnvironmentFile=-/etc/snowos/secrets/nyx_api_key.env
Environment="PYTHONPATH=/opt/snowos:/opt/snowos/ai:/opt/snowos/ui_engine:/opt/snowos/kernel_layer:/opt/snowos/kernel_layer/performance:/opt/snowos/system_services:/opt/snowos/runtime"
WorkingDirectory=/opt/snowos/ai
ExecStart=/usr/bin/python3 /opt/snowos/ai/nyx_daemon.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=3

# Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/snowos /var/log/snowos /run/snowos /tmp

[Install]
WantedBy=multi-user.target
