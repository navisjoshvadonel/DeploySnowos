#!/usr/bin/env python3
"""
SnowOS Main Command Line Interface
Hardened platform management tool for health checks, modes, and rollbacks.
"""

import sys
import os
import argparse
import subprocess
import socket
import json
import shutil

RUNTIME_DIR = os.environ.get("SNOWOS_RUNTIME_DIR", "/run/snowos")

# ── All registered SnowOS systemd services ────────────────────────────────────
_ALL_SERVICES = [
    "snowos-boot.service",
    "snowos-broker.service",
    "snowos-sentinel.service",
    "snowos-aicore.service",
    "snowos-healbridge.service",
    "snowos-nyxvfs.service",
    "snowos-governor.service",
    "snowos-optimizer.service",
    "snowos-frostbite.service",
    "snowos-control.service",
]

# ── IPC sockets to probe ───────────────────────────────────────────────────────
_ALL_SOCKETS = [
    ("Broker Socket",        "broker.sock"),
    ("Sentinel Socket",      "sentinel.sock"),
    ("NyxVFS Socket",        "nyxvfs.sock"),
    ("Healing Bridge Socket","nyx_heal.sock"),
    ("Nyx AI Socket",        "nyx.sock"),
]


def _service_status(name: str) -> str:
    """Return the systemctl is-active text for a service."""
    try:
        return subprocess.run(
            ["systemctl", "is-active", name],
            capture_output=True, text=True,
        ).stdout.strip()
    except Exception:
        return "unknown"


def run_update():
    print("Initiating SnowOS System Update...")
    print("[1/2] Synchronizing Ubuntu security patches...")
    res = subprocess.run(["sudo", "apt-get", "update", "-y"])
    if res.returncode == 0:
        print("  [OK] APT package index refreshed.")
    else:
        print("  [WARN] APT package index returned non-zero code.")

    print("[2/2] Re-verifying SnowOS runtime integrity...")
    integrity_script = "/opt/snowos/validation/check_health.py"
    if os.path.exists(integrity_script):
        subprocess.run(["python3", integrity_script])
    else:
        print("  [OK] Runtime validated.")
    print("Update routine completed.")


def run_doctor():
    print("=== SnowOS Real-Time Health Diagnostics ===\n")

    # ── Service health ─────────────────────────────────────────────────────────
    print("Services:")
    all_ok = True
    for s in _ALL_SERVICES:
        status = _service_status(s)
        mark   = "✔" if status == "active" else "✖"
        if status != "active":
            all_ok = False
        print(f"  [{mark}] {s:<38} {status.upper()}")

    # ── IPC socket probe ───────────────────────────────────────────────────────
    print("\nIPC Sockets:")
    for name, fname in _ALL_SOCKETS:
        sock_path = os.path.join(RUNTIME_DIR, fname)
        if os.path.exists(sock_path):
            print(f"  [✔] {name:<26} Active  ({sock_path})")
        else:
            print(f"  [ℹ] {name:<26} Missing ({sock_path})")

    # ── Integrity manifest ─────────────────────────────────────────────────────
    manifest = "/etc/snowos/integrity_manifest.json"
    print(f"\n  {'[✔]' if os.path.exists(manifest) else '[✖]'} "
          f"Integrity Manifest: {'Active' if os.path.exists(manifest) else 'Missing'} ({manifest})")

    # ── Healing status summary ─────────────────────────────────────────────────
    status_file = os.path.join(RUNTIME_DIR, "healing_status.json")
    if os.path.exists(status_file):
        try:
            with open(status_file) as f:
                hs = json.load(f)
            services_tracked = [k for k in hs if k != "updated_at"]
            if services_tracked:
                print(f"\nHealing Status ({hs.get('updated_at', 'n/a')[:19]}):")
                for svc in services_tracked:
                    rec = hs[svc]
                    outcome = rec.get("outcome", "unknown")
                    mark = "✔" if outcome == "success" else ("⏳" if outcome == "pending" else "✖")
                    print(f"  [{mark}] {svc}: {outcome}")
        except Exception:
            pass

    print(f"\n{'✅ All systems nominal.' if all_ok else '⚠️  One or more services need attention.'}")


def run_ai_status():
    print("=== SnowOS AI Core Status ===\n")

    # Daemon systemctl state
    aicore_status = _service_status("snowos-aicore.service")
    healbridge_status = _service_status("snowos-healbridge.service")
    mark_ai = "✔" if aicore_status == "active" else "✖"
    mark_hb = "✔" if healbridge_status == "active" else "✖"
    print(f"  [{mark_ai}] AI Core (nyx_daemon)  : {aicore_status.upper()}")
    print(f"  [{mark_hb}] Healing Bridge        : {healbridge_status.upper()}")

    # AI features file
    feature_file = "/etc/snowos/ai_features.json"
    if os.path.exists(feature_file):
        try:
            with open(feature_file) as f:
                features = json.load(f)
            print(f"\n  Active Capabilities   : {len(features)} configured")
        except Exception:
            pass

    # Healing outcome summary from tracker
    heal_hist = os.path.expanduser("~/.snowos/healing_history.jsonl")
    status_file = os.path.join(RUNTIME_DIR, "healing_status.json")
    if os.path.exists(status_file):
        try:
            with open(status_file) as f:
                hs = json.load(f)
            services = [k for k in hs if k != "updated_at"]
            if services:
                print(f"\n  Healing Summary (last status per service):")
                for svc in services:
                    rec  = hs[svc]
                    out  = rec.get("outcome", "—")
                    ts   = rec.get("iso_ts", "")[:19]
                    plan = rec.get("plan", {})
                    print(f"    {svc}  →  {out}  (action: {plan.get('action','?')}, "
                          f"confidence: {plan.get('confidence','?')}, at: {ts})")
        except Exception as e:
            print(f"  [WARN] Could not read healing status: {e}")

    if not os.path.exists(status_file):
        print("\n  No healing activity recorded yet.")


def run_rollback():
    print("Initiating SnowOS System Rollback...")
    candidate_scripts = [
        "/opt/snowos/scripts/rollback.sh",
        "/etc/snowos/rollback.sh",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../rollback.sh")
    ]
    rollback_script = None
    for cand in candidate_scripts:
        if os.path.exists(cand):
            rollback_script = os.path.abspath(cand)
            break

    if rollback_script:
        st = os.stat(rollback_script)
        if st.st_mode & 0o002:
            print("[-] Security Error: rollback script is world-writable. Execution aborted.")
            sys.exit(1)
        print(f"Executing: sudo bash {rollback_script}")
        subprocess.run(["sudo", "bash", rollback_script])
    else:
        print("[-] Error: rollback.sh could not be located on this system.")
        sys.exit(1)


def run_shell(action: str):
    """Manage or launch the Frost Shell / Nyx interactive session."""
    if action == "launch":
        candidates = [
            "/opt/snowos/ai_core/nyx_kernel/nyx.py",
            "/opt/snowos/ai/nyx.py",
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../snowos-runtime/src/ai_core/nyx_kernel/nyx.py"),
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../ai/nyx.py"),
        ]
        target = None
        for cand in candidates:
            if os.path.exists(cand):
                target = cand
                break
        if target:
            os.execv(sys.executable, [sys.executable, target])
        else:
            print("[-] Error: Nyx shell script not found in known locations.")
            sys.exit(1)
    elif action == "restart":
        print("Restarting Frost Shell...")
        subprocess.run(["sudo", "systemctl", "restart", "snowos-frostbite.service"])
    elif action == "logs":
        subprocess.run(["journalctl", "-u", "snowos-frostbite.service",
                        "-n", "100", "--no-pager"])
    elif action == "config":
        config_path = "/etc/snowos/frost_shell.conf"
        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nano"
        if not os.path.exists(config_path):
            try:
                os.makedirs(os.path.dirname(config_path), exist_ok=True)
                with open(config_path, "w") as f:
                    f.write("# Frost Shell configuration\n"
                            "# See /opt/snowos/docs/frost_shell.md for option reference\n\n"
                            "[general]\n"
                            "theme=frost-dark\n"
                            "font=JetBrainsMono Nerd Font\n"
                            "font_size=12\n")
                print(f"Created default config at {config_path}")
            except PermissionError:
                print(f"[-] Cannot create {config_path} — run with sudo or "
                      f"use 'sudo snowos shell config'")
                sys.exit(1)
        if shutil.which(editor):
            subprocess.run([editor, config_path])
        else:
            print(f"[-] Editor '{editor}' not found. Set $EDITOR or install it.")
            sys.exit(1)


def run_control():
    """Launch or print SnowControl Dashboard web address."""
    control_url = os.environ.get("SNOWOS_CONTROL_URL", "http://127.0.0.1:8000")
    print(f"SnowControl Interface: {control_url}")
    if shutil.which("xdg-open"):
        subprocess.run(["xdg-open", control_url])
    elif shutil.which("firefox"):
        subprocess.run(["firefox", control_url])
    else:
        print(f"To access SnowControl, open {control_url} in your browser.")


def main():
    parser = argparse.ArgumentParser(
        description="SnowOS Management CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  snowos doctor               — full system health check\n"
            "  snowos control              — open SnowControl dashboard\n"
            "  snowos shell launch         — open interactive Nyx terminal\n"
            "  snowos ai status            — AI core and healing summary\n"
            "  snowos ai logs              — live AI core journal\n"
            "  snowos shell config         — edit Frost Shell config\n"
            "  snowos mode developer       — switch to developer mode\n"
        )
    )
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("update",   help="Perform system update and integrity check")
    subparsers.add_parser("doctor",   help="Run full system diagnostics (all services + sockets)")
    subparsers.add_parser("control",  help="Open SnowControl System Dashboard")
    subparsers.add_parser("rollback", help="Safely revert SnowOS platform modifications")

    ai_parser = subparsers.add_parser("ai", help="Manage AI subsystem")
    ai_parser.add_argument("action", choices=["status", "restart", "logs"])

    shell_parser = subparsers.add_parser("shell", help="Manage Frost Shell")
    shell_parser.add_argument("action", choices=["launch", "restart", "logs", "config"])

    mode_parser = subparsers.add_parser("mode", help="Switch SnowOS operational mode")
    mode_parser.add_argument("type", choices=["developer", "student"])

    args = parser.parse_args()

    if args.command == "update":
        run_update()
    elif args.command == "doctor":
        run_doctor()
    elif args.command == "control":
        run_control()
    elif args.command == "ai":
        if args.action == "status":
            run_ai_status()
        elif args.action == "restart":
            subprocess.run(["sudo", "systemctl", "restart", "snowos-aicore.service"])
        elif args.action == "logs":
            subprocess.run(["journalctl", "-u", "snowos-aicore.service", "-n", "100", "--no-pager"])
    elif args.command == "rollback":
        run_rollback()
    elif args.command == "shell":
        run_shell(args.action)
    elif args.command == "mode":
        if args.type == "developer":
            print("Switching to Developer Mode...")
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface",
                            "color-scheme", "prefer-dark"], capture_output=True)
            subprocess.run(["gsettings", "set", "org.gnome.nautilus.preferences",
                            "show-hidden-files", "true"], capture_output=True)
            print("Developer Mode activated: Dark theme enforced, hidden files visible.")
        elif args.type == "student":
            print("Switching to Student Mode...")
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface",
                            "color-scheme", "prefer-light"], capture_output=True)
            subprocess.run(["gsettings", "set", "org.gnome.nautilus.preferences",
                            "show-hidden-files", "false"], capture_output=True)
            print("Student Mode activated: Focus environment enabled.")
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
